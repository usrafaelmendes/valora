{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Valora",
  "version": "0.1.1",
  "identifier": "com.comparaprecos.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Valora",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "Valora",
    "category": "Business",
    "shortDescription": "Comparação de fornecedores pelo custo efetivo de aquisição",
    "longDescription": "Valora compara cotações de fornecedores pelo custo efetivo de aquisição, considerando os créditos tributários configurados. Funciona localmente, sem serviços externos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
